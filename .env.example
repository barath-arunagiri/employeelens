# Copy this file to .env and fill in your Groq key. Never commit .env.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DATA_MANAGEMENT_ENABLED=true
# Optional prototype-only PIN. Leave empty to disable PIN gating.
DATA_MANAGEMENT_PIN=

# Set to false to flag certifications that look copy-pasted in the source sheet
TRUST_CERTIFICATIONS=true
