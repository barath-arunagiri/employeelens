# Copy these settings into Streamlit Community Cloud's App settings > Secrets.
# Never commit real values or the actual secrets.toml file.
[databricks]
host = "https://<your-workspace-host>"
client_id = "<service-principal-application-id>"
client_secret = "doseab920cce8c905ef5b819e80f3510256a"
sql_warehouse_id = "<sql-warehouse-id>"
model = "databricks-gpt-oss-120b"

# Enable writes only after configuring verified identity below and listing the
# authorized administrator email addresses. The app still fails closed without
# a verified Databricks Apps or OIDC identity.
data_management_enabled = false
data_management_admins = ""

# For Streamlit Community Cloud, configure a Google OAuth client and then
# uncomment/configure this section. Use the exact app URL in Google Cloud's
# authorized redirect URIs.
#
# [auth]
# redirect_uri = "https://<your-app-subdomain>.streamlit.app/oauth2callback"
# cookie_secret = "<long-random-secret>"
# client_id = "<google-oauth-client-id>"
# client_secret = "<google-oauth-client-secret>"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
